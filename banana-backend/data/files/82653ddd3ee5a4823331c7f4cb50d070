product_type - varchar(50) - тип продукта
console_id - int - связь с таблицей console (какая консоль на складе)(многие к одному). Определяет модель товара на складе. Нужен для подсчета физических остатков по конкретной позиции.
pc_id - int - связь с таблицей PC (какой ПК на складе)(многие к одному). Определяет модель товара на складе. Нужен для подсчета физических остатков по конкретной позиции.
vr_id - int - связь с таблицей VR (какое VR-устройство на складе)(многие к одному). Определяет модель товара на складе. Нужен для подсчета физических остатков по конкретной позиции.
warehouse_id - int - связь с таблицей warehouses (на каком складе лежит)(многие к одному). Указывает склад хранения. Разделяет остатки по локациям, чтобы знать, где именно искать товар.
quantity - int - текущее количество
supplier_id - int - связь с таблицей suppliers (от какого поставщика пришла партия)(многие к одному). Фиксирует поставщика партии. Нужен для контроля качества и оформления возврата брака.
purchase_price - decimal(10,2) - закупочная цена
min_quantity - int - минимальный остаток для автозаказа
location - varchar(50) - точное место хранения (стеллаж, полка, ячейка)